<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanum_hardware</name>
  <version>0.0.1</version>
  <description>ros2_control hardware for the mecanum base: the tapped wheel encoder model (decision 0006) and the Gazebo system plugin that reports the wheel state through it. The ESP32 plugin follows on hardware.</description>
  <maintainer email="claude.raseksha@gmail.com">hegde-aryan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Simulation plugin only; skipped by CMake where Gazebo is not installed -->
  <depend>gz_ros2_control</depend>
  <depend>gz_sim_vendor</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
