<?xml version="1.0" ?>
<!--
  sensor_test.sdf: one test object per sensor, in the open, for docs/plan.md Phase 2.
  tools/sensor_check.py puts the robot at a station facing each object and reads this file for
  the object's pose and size, so keep the object links plain boxes.

  STAND-IN: the objects and their sizes are illustrative, not measured fixtures.

  Layout (metres, world frame, z up). The robot spawns at (0, -1) on the floor, clear of all of
  them. Stations are at x = 0, facing +x, unless noted.

    y     object              what it is                        must be seen by
    0     low_threshold       5 cm high, under the 2D lidar     D435i
    3     stall_partition     floor gap to 0.15 m               D435i, L2; the 2D lidar passes under
   -3     counter_overhang    z 0.6..0.85, nothing below it     D435i, L2
   -6     glass_panel         hidden from all optical sensors   ultrasonics
    6     floor hole          x 1..2.2, y 5.4..6.6, 1 m deep    cliff ToF
    9     bumper_wall         0.09 m high                       bumper planks

  The bumper wall is lower than the underside of the body (0.099 m) and of the 2D lidar
  (0.094 m), so the plank hits first even though the lidar stands further forward. That keeps
  this test independent of decision D2 in docs/plan.md.

  The floor is four thick boxes around the hole instead of a ground plane, with the friction of
  restroom.sdf. glass_panel uses the same visibility flag as restroom.sdf (shortcut S4).
-->
<sdf version="1.9">
  <world name="sensor_test">

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensor rendering (gpu_lidar, rgbd_camera) and IMU sensors -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- Contact sensors (simulated bumpers) -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="floor_west">
        <pose>-3.5 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>9 24 1</size></box></geometry>
          <surface><friction><ode><mu>50</mu></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>9 24 1</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <link name="floor_east">
        <pose>5.1 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.8 24 1</size></box></geometry>
          <surface><friction><ode><mu>50</mu></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.8 24 1</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <link name="floor_south">
        <pose>1.6 -3.3 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.2 17.4 1</size></box></geometry>
          <surface><friction><ode><mu>50</mu></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 17.4 1</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <link name="floor_north">
        <pose>1.6 9.3 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.2 5.4 1</size></box></geometry>
          <surface><friction><ode><mu>50</mu></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 5.4 1</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <link name="hole_bottom">
        <pose>1.6 6 -1.05 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.2 1.2 0.1</size></box></geometry>
          <surface><friction><ode><mu>50</mu></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.1</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="test_objects">
      <static>true</static>
      <link name="low_threshold">
        <pose>1.5 0 0.025 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 2 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 2 0.05</size></box></geometry>
          <material><ambient>0.35 0.32 0.30 1</ambient><diffuse>0.35 0.32 0.30 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <link name="stall_partition">
        <pose>1.5 3 0.95 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 1.6 1.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.6 1.6</size></box></geometry>
          <material><ambient>0.75 0.70 0.60 1</ambient><diffuse>0.75 0.70 0.60 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <link name="counter_overhang">
        <pose>2.6 -3 0.725 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 2 0.25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 2 0.25</size></box></geometry>
          <material><ambient>0.35 0.32 0.30 1</ambient><diffuse>0.35 0.32 0.30 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <link name="glass_panel">
        <pose>1.5 -6 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.02 1.5 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.02 1.5 2</size></box></geometry>
          <transparency>0.7</transparency>
          <visibility_flags>268435456</visibility_flags>
          <material><ambient>0.6 0.8 0.9 1</ambient><diffuse>0.6 0.8 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <link name="bumper_wall">
        <pose>1 9 0.045 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 1 0.09</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 1 0.09</size></box></geometry>
          <material><ambient>0.35 0.32 0.30 1</ambient><diffuse>0.35 0.32 0.30 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
