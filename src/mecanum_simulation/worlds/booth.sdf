<?xml version="1.0" ?>
<!--
  booth.sdf: the exhibition booth of the demo (docs/demo_app.md), primitives only.

  STAND-IN: the booth is 2 x 2 m, estimated from a photo, as in docs/Booth demo simulator.html.
  Replace the layout with the real booth's measurements.

  Layout (metres, world frame = map frame, z up). The simulator's x is x here and its z is -y,
  so the open front and the aisle are towards -y:
    booth      x -1..1, y -1..1; walls at the back (y = 1), left and right, front open
    toilet_1   on the right wall at y = 0.30, bowl front edge at x = 0.30
    counter    front left, x -1..-0.05, y -1.1..-0.6 (the leader arm stands on it)
    chair      back right corner, x 0.495..0.945, y 0.535..0.985 (a box)
    tv         on the right wall, visual only
    tape       home outline around (-0.50, 0.35) and dock outline around (-0.171, 0.30),
               visual only; the poses themselves are in mecanum_demo/config/booth_demo.yaml
    aisle      y -4..-1, x -4..4, with a wall on its far side and the neighbouring booths'
               fronts, so that the 2D lidar has something to see when the robot faces the aisle
    visitor    a person-sized cylinder parked at the east end of the aisle; the booth_visitor
               node (mecanum_simulation) moves it to the booth front and back (sim shortcut
               S12). It is not static, so it is not in the map.

  There is no ceiling: the booth is open on top.
-->
<sdf version="1.9">
  <world name="booth">

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensor rendering (gpu_lidar, rgbd_camera) and IMU sensors -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- Contact sensors (simulated bumpers) -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface>
            <friction>
              <!-- STAND-IN: real floor friction is unknown (tiles, wet floors); measure the
                   force to slide the robot sideways, or tune until sim slip matches the
                   real robot. Value mirrors Gazebo's mecanum_drive demo. -->
              <ode><mu>50</mu></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="booth">
      <static>true</static>
      <!-- booth walls, 0.1 m thick, outside the 2 x 2 m floor; the front (y = -1) is open -->
      <link name="wall_back">
        <pose>0 1.05 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.1 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.1 2.4</size></box></geometry><material><ambient>0.96 0.95 0.93 1</ambient><diffuse>0.96 0.95 0.93 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="wall_left">
        <pose>-1.05 0 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 2.0 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 2.0 2.4</size></box></geometry><material><ambient>0.96 0.95 0.93 1</ambient><diffuse>0.96 0.95 0.93 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="wall_right">
        <pose>1.05 0 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 2.0 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 2.0 2.4</size></box></geometry><material><ambient>0.96 0.95 0.93 1</ambient><diffuse>0.96 0.95 0.93 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <!-- toilet_1 (STAND-IN shape, as in restroom.sdf): tank on the right wall, bowl front
           edge at x = 0.30, centred on y = 0.30 -->
      <link name="toilet_1_tank">
        <pose>0.92 0.3 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.16 0.38 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.16 0.38 0.4</size></box></geometry><material><ambient>0.97 0.97 0.97 1</ambient><diffuse>0.97 0.97 0.97 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="toilet_1_pedestal">
        <pose>0.74 0.3 0.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.22 0.25 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.22 0.25 0.4</size></box></geometry><material><ambient>0.97 0.97 0.97 1</ambient><diffuse>0.97 0.97 0.97 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="toilet_1_bowl">
        <pose>0.49 0.3 0.2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.19</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.19</radius><length>0.4</length></cylinder></geometry><material><ambient>0.97 0.97 0.97 1</ambient><diffuse>0.97 0.97 0.97 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <!-- counter with the leader arm, at the front left: x -1..-0.05, y -1.1..-0.6 -->
      <link name="counter">
        <pose>-0.525 -0.85 0.44 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.95 0.5 0.88</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.95 0.5 0.88</size></box></geometry><material><ambient>0.95 0.94 0.92 1</ambient><diffuse>0.95 0.94 0.92 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <!-- chair in the back right corner, simplified to a box: x 0.495..0.945, y 0.535..0.985 -->
      <link name="chair">
        <pose>0.72 0.76 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.45 0.45 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.8</size></box></geometry><material><ambient>0.17 0.17 0.16 1</ambient><diffuse>0.17 0.17 0.16 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <!-- TV on the right wall (visual only) -->
      <link name="tv">
        <pose>0.985 0.45 1.45 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.03 0.84 0.5</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <!-- floor tape (visual only, 2 mm): home and dock outlines for the 0.83 x 0.52 m footprint -->
      <link name="tape_home_s">
        <pose>-0.51 0.07 0.001 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.86 0.02 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="tape_home_n">
        <pose>-0.51 0.63 0.001 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.86 0.02 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="tape_home_w">
        <pose>-0.94 0.35 0.001 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.02 0.56 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="tape_home_e">
        <pose>-0.08 0.35 0.001 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.02 0.56 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="tape_dock_s">
        <pose>-0.16499999999999998 0.02 0.001 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.87 0.02 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="tape_dock_n">
        <pose>-0.16499999999999998 0.58 0.001 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.87 0.02 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="tape_dock_w">
        <pose>-0.6 0.3 0.001 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.02 0.5599999999999999 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="tape_dock_e">
        <pose>0.27 0.3 0.001 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.02 0.5599999999999999 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
    </model>

    <model name="aisle">
      <static>true</static>
      <!-- the far side of the aisle: a wall 3 m from the booth front, and the neighbours' fronts -->
      <link name="wall_opposite">
        <pose>0 -4.05 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8.2 0.1 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.1 2.4</size></box></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="neighbour_left">
        <pose>-2.6 -0.95 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.0 0.1 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.1 2.4</size></box></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="neighbour_right">
        <pose>2.6 -0.95 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.0 0.1 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.1 2.4</size></box></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="aisle_end_west">
        <pose>-4.05 -2.5 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 3.2 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.2 2.4</size></box></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="aisle_end_east">
        <pose>4.05 -2.5 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 3.2 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.2 2.4</size></box></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
    </model>

    <model name="carpet">
      <static>true</static>
      <link name="booth_floor">
        <pose>0 0 0.0005 0 0 0</pose>
        <visual name="visual"><geometry><box><size>2.0 2.0 0.001</size></box></geometry><material><ambient>0.72 0.26 0.23 1</ambient><diffuse>0.72 0.26 0.23 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="aisle_floor">
        <pose>0 -2.5 0.0004 0 0 0</pose>
        <visual name="visual"><geometry><box><size>8.0 3.0 0.0008</size></box></geometry><material><ambient>0.62 0.2 0.17 1</ambient><diffuse>0.62 0.2 0.17 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
    </model>

    <!-- The visitor: moved by /world/booth/set_pose (booth_visitor). Not static, so that the
         pose command moves its collision too; gravity is off and it never touches the ground
         plane's friction (it floats 1 mm up), so it stays where it is put. -->
    <model name="visitor">
      <pose>3.5 -3.0 0.651 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial><mass>60</mass><inertia><ixx>10</ixx><iyy>10</iyy><izz>1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.17</radius><length>1.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.17</radius><length>1.3</length></cylinder></geometry><material><ambient>0.5 0.47 0.87 1</ambient><diffuse>0.5 0.47 0.87 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <visual name="head"><pose>0 0 0.76 0 0 0</pose><geometry><sphere><radius>0.11</radius></sphere></geometry><material><ambient>0.5 0.47 0.87 1</ambient><diffuse>0.5 0.47 0.87 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
    </model>

  </world>
</sdf>
