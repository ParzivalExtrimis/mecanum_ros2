<?xml version="1.0"?>
<!-- Robot body: base_footprint, base_link (chassis) and the four wheels. -->
<!-- REWRITE: frame skeleton only. The previous model's chassis mesh, collision box, inertia,
     wheel meshes and wheel positions were removed (see REWRITE.md). The link and joint names are
     kept because other packages use them. Rename them only together with REWRITE.md
     "Kept, re-check after the rewrite". -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mecanum_robot" params="prefix">

    <!-- Ground-projected robot frame (REP-105) -->
    <link name="${prefix}base_footprint" />

    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${prefix}base_footprint" />
      <child link="${prefix}base_link" />
      <!-- REWRITE: origin removed. Lift base_link to the new wheel axle height (z = wheel
           radius) so base_footprint stays on the floor. -->
    </joint>

    <!-- base_link sits at wheel axle height -->
    <!-- REWRITE: visual, collision and inertial removed. Add them from the new chassis meshes
         (meshes/visual, meshes/collision), including the new geometry meshes. -->
    <link name="${prefix}base_link" />

    <!-- REWRITE: wheel meshes and positions removed. Pass the new wheel meshes and the wheel
         centres (front/rear axle x, +-track/2) once mecanum_params.xacro defines them. -->
    <xacro:mecanum_wheel prefix="${prefix}" name="front_left" parent="base_link" />
    <xacro:mecanum_wheel prefix="${prefix}" name="front_right" parent="base_link" />
    <xacro:mecanum_wheel prefix="${prefix}" name="rear_left" parent="base_link" />
    <xacro:mecanum_wheel prefix="${prefix}" name="rear_right" parent="base_link" />

  </xacro:macro>

</robot>
