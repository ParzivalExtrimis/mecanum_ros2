<?xml version="1.0"?>
<!-- A single mecanum wheel: link and continuous joint. -->
<!-- REWRITE: frame skeleton only. The previous mesh visual, cylinder collision, inertia and the
     mesh and x, y, z macro parameters were removed (see REWRITE.md). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    prefix:   robot-wide prefix (e.g. "" or "robot1_")
    name:     wheel position, e.g. "front_left"
    parent:   link the wheel attaches to
  -->
  <xacro:macro name="mecanum_wheel" params="prefix name parent">

    <!-- REWRITE: visual, collision and inertial from the new wheel meshes. Keep exactly one
         unnamed collision per wheel link: the Gazebo friction block in
         mecanum_simulation/urdf/mecanum.gazebo.xacro merges into it by name. -->
    <link name="${prefix}${name}_wheel_link"/>

    <joint name="${prefix}${name}_wheel_joint" type="continuous">
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}${name}_wheel_link"/>
      <!-- REWRITE: wheel centre origin removed; set it from the new geometry -->
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

</robot>
