<?xml version="1.0"?>
<!-- A single mecanum wheel: mesh visual, cylinder collision. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    prefix:   robot-wide prefix (e.g. "" or "robot1_")
    name:     wheel position, e.g. "front_left"
    parent:   link the wheel attaches to
    mesh:     visual mesh (roller handedness)
    x, y, z:  wheel centre relative to parent
  -->
  <xacro:macro name="mecanum_wheel" params="prefix name parent mesh x y z:=0.0">

    <link name="${prefix}${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertia>
    </link>

    <joint name="${prefix}${name}_wheel_joint" type="continuous">
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

</robot>
