<?xml version="1.0"?>
<!-- Inertia macros for solid primitives (about the centre of mass). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box with dimensions x, y, z -->
  <xacro:macro name="box_inertia" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
               izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder with its axis along the local z axis -->
  <xacro:macro name="cylinder_inertia" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3*radius*radius + length*length) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (3*radius*radius + length*length) / 12.0}" iyz="0.0"
               izz="${mass * radius*radius / 2.0}"/>
    </inertial>
  </xacro:macro>

</robot>
