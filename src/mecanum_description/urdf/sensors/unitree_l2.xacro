<?xml version="1.0"?>
<!--
  Unitree L2 4D LiDAR: mount link, lidar frame and IMU frame.

  Included from mecanum.urdf.xacro when use_l2 is true (the default).

  Mount: upright on a 30 mm standoff on the top of the tall box, behind the robot centre
  (PDF schedule: "box top on 30 mm standoff, upright, negative-angle mode"). The STEP model has
  the L2 sunk 40 mm into the box top, which contradicts the PDF; the PDF mounting is used. The
  standoff is drawn with the L2's footprint; its real shape is unknown.

  Field of view: the hemisphere on the L2's +Z (dome) side, so upright it sees up and around:
  elevation 0..90 deg in standard mode, -6..90 deg in negative-angle (wide) mode, which the PDF
  asks for. From 0.80 m it sees the walls above the robot and the ceiling; in wide mode it
  reaches 0.45 m-high objects only beyond about 3.1 m. It sees almost none of the robot.

  Frames (all fixed joints, published by robot_state_publisher):
    <parent> -> l2_mount   centre of the L2's bottom mounting face (the standoff top), z up into
                           the dome. 0.767 m above the floor; the housing centre (the reference
                           URDF's unitree_l2_link) is 32.5 mm above it, at 0.799 m.
    l2_mount -> l2_lidar   vendor point-cloud frame, rotated about z by l2_cable_yaw.
    l2_lidar -> l2_imu     vendor IMU frame: axes parallel to l2_lidar, origin at
                           (-0.007698, -0.014655, 0.00667) m in l2_lidar.
  Vendor frame definition (unilidar_sdk2 README): origin at the centre of the bottom mounting
  surface, +X away from the cable outlet, +Z normal to the bottom surface into the sensor.
  The L2 driver (mecanum_lidar) stamps its messages with l2_lidar / l2_imu.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Vendor datasheet values (not stand-ins) -->
  <xacro:property name="l2_body_size" value="0.075"/>
  <xacro:property name="l2_body_height" value="0.065"/>
  <xacro:property name="l2_mass" value="0.230"/>
  <!-- IMU origin in the lidar frame, from the unilidar_sdk2 README -->
  <xacro:property name="l2_imu_x" value="-0.007698"/>
  <xacro:property name="l2_imu_y" value="-0.014655"/>
  <xacro:property name="l2_imu_z" value="0.00667"/>

  <!-- Mount pose in base_link. x, y from the STEP body. z = STEP box top (0.7369 m above the
       floor) + 30 mm standoff - wheel_radius.
       STAND-IN: the height follows the PDF standoff rule, not the STEP; measure the mounted
       L2 bottom face height. -->
  <xacro:property name="l2_mount_x" value="-0.100"/>
  <xacro:property name="l2_mount_y" value="0.0"/>
  <xacro:property name="l2_mount_z" value="${0.7369 + 0.030 - wheel_radius}"/>
  <xacro:property name="l2_standoff_height" value="0.030"/>
  <!-- STAND-IN: cable direction unknown. 0 = vendor +X forward, cable outlet to the rear.
       Read it on the robot (vendor +X points away from the cable) and set the yaw from
       above, counter-clockwise positive. -->
  <xacro:property name="l2_cable_yaw" value="0.0"/>

  <xacro:macro name="unitree_l2" params="prefix parent">

    <joint name="${prefix}l2_mount_joint" type="fixed">
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}l2_mount"/>
      <origin xyz="${l2_mount_x} ${l2_mount_y} ${l2_mount_z}" rpy="0 0 0"/>
    </joint>

    <!-- L2 body above the mounting face and the standoff below it. Mass: the L2 only (the
         standoff is counted in chassis_mass). -->
    <link name="${prefix}l2_mount">
      <xacro:box_inertia mass="${l2_mass}" x="${l2_body_size}" y="${l2_body_size}"
        z="${l2_body_height}">
        <origin xyz="0 0 ${l2_body_height/2}" rpy="0 0 0"/>
      </xacro:box_inertia>
      <visual>
        <origin xyz="0 0 ${l2_body_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${l2_body_size} ${l2_body_size} ${l2_body_height}"/>
        </geometry>
        <material name="l2_purple"/>
      </visual>
      <visual>
        <origin xyz="0 0 ${-l2_standoff_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${l2_body_size} ${l2_body_size} ${l2_standoff_height}"/>
        </geometry>
        <material name="mount_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${(l2_body_height - l2_standoff_height)/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${l2_body_size} ${l2_body_size} ${l2_body_height + l2_standoff_height}"/>
        </geometry>
      </collision>
    </link>

    <!-- Point cloud frame (vendor lidar frame) -->
    <joint name="${prefix}l2_lidar_joint" type="fixed">
      <parent link="${prefix}l2_mount"/>
      <child link="${prefix}l2_lidar"/>
      <origin xyz="0 0 0" rpy="0 0 ${l2_cable_yaw}"/>
    </joint>
    <link name="${prefix}l2_lidar"/>

    <!-- Built-in 6-axis IMU frame: vendor offset in the lidar frame -->
    <joint name="${prefix}l2_imu_joint" type="fixed">
      <parent link="${prefix}l2_lidar"/>
      <child link="${prefix}l2_imu"/>
      <origin xyz="${l2_imu_x} ${l2_imu_y} ${l2_imu_z}" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}l2_imu"/>

  </xacro:macro>

  <xacro:unitree_l2 prefix="$(arg prefix)" parent="base_link"/>

</robot>
