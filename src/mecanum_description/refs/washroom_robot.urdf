  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <!-- ===== Wheels: STEP bodies 'Folder 28*' (r = 102.5 mm, width 85.0 mm). continuous joints at the tread centre; axis +y for all four, so a POSITIVE joint velocity rolls the robot FORWARD on every wheel. Mecanum rollers are not in the CAD: roller handedness (X vs O layout) must be set in the drive controller, not here. White bar = rotation marker for RViz. ===== -->
  <link name="front_left_wheel_link">
    <inertial>
      <origin xyz="0 -0.0003 0" rpy="0 0 0"/>
      <mass value="1.500"/>
      <inertia ixx="0.00582886" ixy="0" ixz="0" iyy="0.0100038" iyz="0" izz="0.00582886"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder radius="0.1025" length="0.085"/>
      </geometry>
      <material name="tyre_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.087"/>
      </geometry>
