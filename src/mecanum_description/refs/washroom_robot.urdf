    </collision>
  </link>
  <joint name="ultrasonic_rear_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_rear_right_link"/>
    <origin xyz="-0.401 -0.2105 0.1957" rpy="0 0 3.141592654"/>
  </joint>
  <!-- ===== Cliff ToF x4 (VL53L1X per BOM). STEP bodies 50x29.6x29 just ahead of / behind each wheel, in line with it. Frame at the centre of the downward face, +x pointing straight down (PDF). NOTE: STEP puts them ~0.12 m up, 2 cm inside the open bottom of the body (kept, with a pocket in chassis_link so the floor is visible); the PDF says 0.08 m. ===== -->
  <link name="cliff_tof_front_left_link">
    <visual>
      <origin xyz="-0.0148 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0296 0.05 0.029"/>
