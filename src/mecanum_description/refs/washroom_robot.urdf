  <!-- ===== Unitree L2 (owned). x/y from STEP body (75x75x65); z from PDF rule 'box top on 30 mm standoff': CAD box top 0.7369 + 0.030 + half height. The STEP has the L2 sunk 40 mm INTO the box top, which contradicts the PDF, so the PDF mounting wins (the white standoff is drawn with the L2's footprint; its real shape is unknown). Frame = housing centre (PDF gives no optical centre); upright, x forward - confirm against Unitree's point-cloud axes before trusting yaw. 'Negative-angle mode' is a driver setting. Massless: mass is inside chassis_link. ===== -->
  <link name="unitree_l2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.075 0.065"/>
      </geometry>
      <material name="l2_purple"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.0475" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.075 0.03"/>
      </geometry>
      <material name="mount_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.075 0.095"/>
      </geometry>
    </collision>
  </link>
  <joint name="unitree_l2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="unitree_l2_link"/>
    <origin xyz="-0.1 0 0.6969" rpy="0 0 0"/>
  </joint>
  <!-- ===== RealSense D435i (owned). STEP body 90x25x25 centred on the front face; frame at the centre of its front face. PDF 'pitched -8 deg' = optical axis 8 deg BELOW horizontal -> URDF pitch +0.139626 rad (positive pitch about +y tips +x down). STEP body itself is not pitched. realsense2_camera with camera_name:=d435i hangs its own depth/colour/IMU frames off d435i_link; those internal offsets (imager positions) are not in the PDF, so they are not modelled here. ===== -->
  <link name="d435i_link">
    <visual>
      <origin xyz="-0.0125 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="d435i_green"/>
    </visual>
    <collision>
      <origin xyz="-0.0125 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
  </link>
  <joint name="d435i_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435i_link"/>
    <origin xyz="0.404 0 0.1614" rpy="0 0.13962634 0"/>
  </joint>
  <!-- Optical frame (REP-103 camera convention): z forward, x right, y down. -->
  <link name="d435i_optical_frame"/>
  <joint name="d435i_optical_joint" type="fixed">
    <parent link="d435i_link"/>
    <child link="d435i_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
  </joint>
  <!-- ===== 2D lidar (SLAMTEC RPLIDAR C1 per BOM). x/y = STEP body centre, z = PDF scan plane 0.13 m. The STEP placeholder is 55.6 wide x 41.3 deep x 55.6 tall, i.e. drawn on its side; kept as drawn for geometry, but the frame follows the PDF: horizontal scan, z up, 0 deg = +x (verify the C1's zero direction on the unit). 200 deg slot -> limit angles in the driver. ===== -->
  <link name="lidar_2d_link">
    <visual>
      <origin xyz="0 0 -0.0078" rpy="0 0 0"/>
      <geometry>
        <box size="0.0413 0.0556 0.0556"/>
      </geometry>
      <material name="lidar_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0078" rpy="0 0 0"/>
      <geometry>
        <box size="0.0413 0.0556 0.0556"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_2d_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_2d_link"/>
    <origin xyz="0.3997 0 0.0275" rpy="0 0 0"/>
  </joint>
  <!-- ===== Ultrasonic x4 (DFRobot A02YYUW per BOM). STEP bodies 84.6x29.6x29 at z~0.30. Frame at the centre of the outward face, +x along the beam (sensor_msgs/Range convention): front pair faces +x, rear pair -x. Cone angle etc. belong in the Range message, not the URDF. ===== -->
  <link name="ultrasonic_front_left_link">
    <visual>
      <origin xyz="-0.0145 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.029 0.0846 0.0296"/>
      </geometry>
      <material name="ultrasonic_ochre"/>
