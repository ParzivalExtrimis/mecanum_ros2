  <!-- ===== Bumper planks (front/rear) on microswitches, modelled fixed. STEP bars 510x25x30 under the body. Frame at plank centre, +x outward. NOTE: in the STEP the front plank is only 5 mm proud of the body and the 2D lidar sticks out 16 mm FURTHER than it - the PDF intends the plank to hit first. ===== -->
  <link name="bumper_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.51 0.03"/>
      </geometry>
      <material name="bumper_red"/>
