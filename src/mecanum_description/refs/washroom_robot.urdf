    </collision>
  </link>
  <joint name="ultrasonic_front_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_front_right_link"/>
    <origin xyz="0.408 -0.1905 0.1937" rpy="0 0 0"/>
  </joint>
  <link name="ultrasonic_rear_left_link">
    <visual>
      <origin xyz="-0.0145 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.029 0.0846 0.0296"/>
      </geometry>
      <material name="ultrasonic_ochre"/>
    </visual>
    <collision>
      <origin xyz="-0.0145 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.029 0.0846 0.0296"/>
      </geometry>
    </collision>
  </link>
  <joint name="ultrasonic_rear_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_rear_left_link"/>
    <origin xyz="-0.401 0.2105 0.1957" rpy="0 0 3.141592654"/>
  </joint>
  <link name="ultrasonic_rear_right_link">
    <visual>
      <origin xyz="-0.0145 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.029 0.0846 0.0296"/>
      </geometry>
      <material name="ultrasonic_ochre"/>
    </visual>
    <collision>
      <origin xyz="-0.0145 0 0" rpy="0 0 0"/>
