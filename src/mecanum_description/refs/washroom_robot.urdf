      <geometry>
        <box size="0.029 0.0846 0.0296"/>
      </geometry>
    </collision>
  </link>
  <joint name="ultrasonic_front_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_front_left_link"/>
    <origin xyz="0.408 0.1905 0.1937" rpy="0 0 0"/>
  </joint>
  <link name="ultrasonic_front_right_link">
    <visual>
      <origin xyz="-0.0145 0 0" rpy="0 0 0"/>
